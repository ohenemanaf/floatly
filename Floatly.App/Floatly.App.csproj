<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <!-- Avoid SDK-generated global System.Drawing and Windows.Forms imports,
         which collide with WPF control and geometry names. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Floatly</AssemblyName>
    <RootNamespace>Floatly</RootNamespace>
    <ApplicationIcon>Assets\Floatly.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- Manrope (SIL Open Font License, see Assets/Fonts/OFL.txt), compiled into the app. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>
</Project>
