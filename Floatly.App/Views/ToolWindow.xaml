<Window x:Class="Floatly.Views.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floatly • Desktop tools"
        Width="404" Height="560" MinWidth="364" MinHeight="460"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource AppFont}" FontSize="12.5"
        UseLayoutRounding="True">
  <!-- The whole window is client area with the system frame extended under it, which is what
       lets Windows 11 draw its acrylic (blurred glass) backdrop behind the content. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Grid>
    <Border x:Name="Tint" Background="#73121522"/>
    <Border Height="170" VerticalAlignment="Top" IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#24FFFFFF" Offset="0"/>
          <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <!-- Icon rail: one click to any tool. -->
      <Border Background="#12FFFFFF" MouseLeftButtonDown="Header_Drag">
        <StackPanel x:Name="Rail" Margin="0,12,0,0"/>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="Header_Drag">
          <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,2,0,0"/>
          <Button x:Name="CloseButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,12,0"
                  Click="Close_Click" ToolTip="Hide panel"/>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,10">
          <StackPanel x:Name="ContentPanel" Margin="18,0,12,8">
            <StackPanel.RenderTransform><TranslateTransform x:Name="ContentSlide"/></StackPanel.RenderTransform>
          </StackPanel>
        </ScrollViewer>
        <!-- Short messages appear here instead of blocking dialogs. -->
        <Border x:Name="ToastHost" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                Background="#F2242838" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,7"
                Opacity="0" IsHitTestVisible="False">
          <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap" MaxWidth="260"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
