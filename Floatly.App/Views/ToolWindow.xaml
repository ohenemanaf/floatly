<Window x:Class="Floatly.Views.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floatly • Desktop tools"
        Width="720" Height="595" MinWidth="550" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip" Topmost="True"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        Foreground="White" FontFamily="Segoe UI" FontSize="13">
  <Border Background="#111524" CornerRadius="22" BorderBrush="#615983" BorderThickness="1" Margin="12">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.6" ShadowDepth="7" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="72"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
          <Border Background="#383055" Width="42" Height="42" CornerRadius="14" Margin="0,0,12,0">
            <TextBlock Text="✦" FontSize="28" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="FLOATLY" FontWeight="Bold" FontSize="17" Foreground="White"/>
            <TextBlock Text="THE LITTLE DESKTOP COMPANION" FontSize="9" Foreground="#A9B2CB"/>
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Width="35" Height="35" Content="×" FontSize="19" Padding="0"
                Style="{StaticResource SecondaryButton}" Click="Close_Click"
                ToolTip="Hide this panel (Floatly keeps running)"/>
      </Grid>
      <Grid Grid.Row="1" Margin="16,0,16,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#1B2134" CornerRadius="16" Padding="10" Margin="0,0,10,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Navigation"/>
          </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Background="#1B2134" CornerRadius="16" Padding="19">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Margin="0,0,8,0"/>
          </ScrollViewer>
        </Border>
      </Grid>
      <Grid Grid.Row="2">
        <TextBlock Text="OFFLINE    •    NO API KEYS    •    PRIVATE LOCAL STORAGE"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#9AA6C6" FontSize="10" />
      </Grid>
    </Grid>
  </Border>
</Window>
